<file path="Ansible/deploy.yml">
---
- name: Déployer le Hub de Secours (ResQ-Net) - Version Démo Stable
  hosts: webservers
  become: yes

  tasks:
    - name: 1. Installer Docker et Docker Compose
      apt:
        name:
          - docker.io
          - docker-compose-v2
        state: present
        update_cache: yes

    - name: 2. Créer le dossier du projet
      file:
        path: /home/ubuntu/hub
        state: directory
        owner: ubuntu
        group: ubuntu
        mode: '0755'

    - name: 3. Copier le fichier docker-compose.yml
      copy:
        dest: /home/ubuntu/hub/docker-compose.yml
        owner: ubuntu
        group: ubuntu
        content: |
          version: '3.8'

          services:
            # ═══════════════════════════════════════════════════════
            # MongoDB (Mode Trusted - Sans Auth pour éviter KeyFile)
            # ═══════════════════════════════════════════════════════
            mongodb:
              image: mongo:5.0
              container_name: disaster-mongodb
              restart: unless-stopped
              command: mongod --replSet rs0 --bind_ip_all
              volumes:
                - ./data/db:/data/db
                - ./data/configdb:/data/configdb
              networks:
                - disaster_network

            # ═══════════════════════════════════════════════════════
            # Le Mécano (Initialisation Simple)
            # ═══════════════════════════════════════════════════════
            mongo-init-replica:
              image: mongo:5.0
              command: >
                bash -c "for i in `seq 1 30`; do
                  mongo mongodb://mongodb:27017/ --eval 'rs.initiate({ _id: \"rs0\", members: [ { _id: 0, host: \"mongodb:27017\" } ] })' &&
                  s=$$? && break || s=$$?;
                  echo 'Waiting for mongo...';
                  sleep 5;
                done; (exit $$s)"
              depends_on:
                - mongodb
              networks:
                - disaster_network

            # ═══════════════════════════════════════════════════════
            # Rocket.Chat
            # ═══════════════════════════════════════════════════════
            rocketchat:
              image: rocket.chat:6.3
              container_name: disaster-rocketchat
              restart: unless-stopped
              ports:
                - "3000:3000"
              environment:
                # Connexion simple sans user/pass
                MONGO_URL: mongodb://mongodb:27017/rocketchat
                MONGO_OPLOG_URL: mongodb://mongodb:27017/local?replicaSet=rs0
                ROOT_URL: http://localhost:3000
                PORT: 3000
                Accounts_UseDNSDomainCheck: "false"
                OVERWRITE_SETTING_Accounts_RegistrationForm: "Public"
              volumes:
                - rocketchat_uploads:/app/uploads
              networks:
                - disaster_network
              depends_on:
                - mongodb

          networks:
            disaster_network:
              driver: bridge

          volumes:
            rocketchat_uploads:
              driver: local

    - name: 4. Lancer les conteneurs
      command: docker compose up -d
      args:
        chdir: /home/ubuntu/hub
</file>

